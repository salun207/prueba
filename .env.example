# --- App ---
BASE_URL=http://localhost:8000
SECRET_KEY=cambiar-esto-en-produccion

# --- Marca / datos públicos del kartódromo ---
BRAND_NAME=Karting Zárate
DIRECCION=Ruta 193 Km 8.5, Zárate, Buenos Aires
EMAIL_CONTACTO=info@kartingzarate.com
# Número para el botón de WhatsApp (E.164 sin '+'). REEMPLAZAR por el real.
WHATSAPP_CONTACTO=5491112345678
# Consulta para el mapa de Google (ubicación del circuito)
MAP_QUERY=Kartódromo Internacional de Zárate

# --- Datos del circuito ---
CIRCUITO_LONGITUD_M=900
CIRCUITO_ANCHO_M=8
CIRCUITO_CURVAS=10
CIRCUITO_RECTAS=3

# --- WhatsApp Cloud API (Meta) ---
# Se obtienen en https://developers.facebook.com -> tu app -> WhatsApp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=karting-zarate-verify
# Si WHATSAPP_TOKEN está vacío, los mensajes se "envían" a la consola (modo demo)

# --- Monitor de disponibilidad ---
MONITOR_INTERVAL=60
# Fuente de datos: "mock" (demo) o "soloturnos" (real, cuando tengamos endpoints)
AVAILABILITY_SOURCE=mock

# --- Panel (protección opcional) ---
# Si dejás PANEL_PASSWORD vacío, el panel queda abierto (modo demo).
# Si lo completás, el panel pide usuario/clave (HTTP Basic).
PANEL_USER=admin
PANEL_PASSWORD=
